{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "TacticalReplayAI",
    "author": "Dang Thanh Kiet",
    "version": "1.4.1",
    "minimum-overwolf-version": "0.240.0",
    "description": "Tự động quay highlight và phân tích chiến thuật VALORANT & PUBG",
    "icon": "IconMouseOver.png",
    "icon_gray": "IconMouseNormal.png",
    "launcher_icon": "launcher_icon.ico"
  },
  "permissions": ["Streaming", "Media", "FileSystem", "GameInfo", "Hotkeys"],
  "data": {
    "start_window": "background",
    "windows": {
      "background": {
        "file": "background.html",
        "is_background_page": true
      },
      "desktop": {
        "file": "index.html",
        "native_window": true,
        "resizable": true,
        "size": { "width": 1360, "height": 820 },
        "min_size": { "width": 1100, "height": 700 }
      }
    },
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [21640, 10906]
    },
    "game_events": [21640, 10906],
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": { "game_ids": [21640, 10906] },
        "start_minimized": true
      }
    ]
  }
}