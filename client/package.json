{
  "name": "fps-tactical-coach-client",
  "private": true,
  "version": "1.7.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop:run": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win nsis",
    "desktop:publish": "npm run build && electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "com.tacticalreplay.ai",
    "productName": "TacticalReplayAI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "icon": "public/launcher_icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "protocols": [
      {
        "name": "TacticalReplayAI Protocol",
        "schemes": [
          "tacticalreplay"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "kietthanh080-lab",
        "repo": "tactical-replay-releases"
      }
    ]
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "electron-updater": "^6.8.11",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@overwolf/types": "^3.51.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
